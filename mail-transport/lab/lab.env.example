# docguard-lab Konfiguration -> kopieren nach lab.env, chmod 600 lab.env
# A = docguard-Postfach, B = keyleash-Postfach.
# Nutze App-Passwörter / dedizierte Test-Postfächer, NIE Hauptpasswörter.

A_ADDRESS=lab@docguard.example
A_SMTP_HOST=smtp.example.com
A_SMTP_PORT=587
A_SMTP_SECURITY=starttls        # starttls | ssl | none (none nur localhost)
A_IMAP_HOST=imap.example.com
A_IMAP_PORT=993
A_USER=lab@docguard.example
A_PASS=app-passwort-hier
A_KEY_FILE=keys/a.key

B_ADDRESS=lab@keyleash.example
B_SMTP_HOST=smtp.example.com
B_SMTP_PORT=587
B_SMTP_SECURITY=starttls
B_IMAP_HOST=imap.example.com
B_IMAP_PORT=993
B_USER=lab@keyleash.example
B_PASS=app-passwort-hier
B_KEY_FILE=keys/b.key

# Optional: Domain für die _docguard-Abfrage überschreiben (z. B. für das lokale DNSSEC-Lab)
# A_KEY_DOMAIN=docguard.lab
# B_KEY_DOMAIN=keyleash.lab

# DNS: validierender Resolver, der das AD-Flag setzt
DG_DNS_RESOLVER=9.9.9.9      # lokales Lab: 127.0.0.1:5302
# 1 = Schlüssel nur akzeptieren, wenn DNSSEC validiert (AD-Flag). 0 = nur fürs Bootstrapping (laute Warnung)
DG_REQUIRE_DNSSEC=1
