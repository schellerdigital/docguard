# Standard-Services (gekürzt auf das Nötige für die Sandbox)
smtp      inet  n       -       n       -       -       smtpd
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
    -o syslog_name=postfix/postlog

# --- docguard: Content-Filter-Pipe (nach SMTP DATA, wie im Konzeptpapier) ---
# ${sender} und alle Empfänger als argv, das Skript entscheidet selbst
# über Verschlüsseln / Fail-Closed und speist die Mail über sendmail
# zurück in die Queue ein (siehe docguard_filter.py).
docguard-filter unix -     n     n     -     10    pipe
    flags=Rq user=nobody argv=/usr/local/bin/docguard_filter.py ${sender} ${recipient}

# --- docguard: Wieder-Einspeisungs-Listener (nur localhost, kein erneuter Filter!) ---
# Ohne "content_filter=" (leer) hier würde die vom Skript re-injizierte
# Mail sonst in einer Endlosschleife nochmal gefiltert werden.
127.0.0.1:10025 inet n  -  n  -  10  smtpd
    -o content_filter=
    -o receive_override_options=no_unknown_recipient_checks,no_header_body_checks
    -o smtpd_helo_restrictions=
    -o smtpd_client_restrictions=
    -o smtpd_sender_restrictions=
    -o smtpd_recipient_restrictions=permit_mynetworks,reject
    -o mynetworks=127.0.0.0/8
    -o smtpd_authorized_xforward_hosts=127.0.0.0/8
